<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <xsd:element name="listaPic">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="Pic" minOccurs="1" maxOccurs="unbounded"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="Pic">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="nome" minOccurs="1" maxOccurs="1"/>
                <xsd:element ref="prezzo" minOccurs="1" maxOccurs="1"/>
                <xsd:element ref="path" minOccurs="1" maxOccurs="1"/>
            </xsd:sequence>
            <xsd:attribute name="id_pic" type="xsd:integer" use="required"/>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="nome" type="xsd:string"/>
    <xsd:element name="prezzo" type="xsd:integer"/>
    <xsd:element name="path" type="xsd:string"/>

</xsd:schema>