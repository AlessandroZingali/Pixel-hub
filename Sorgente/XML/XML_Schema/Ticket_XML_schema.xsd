<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" >

  <xsd:element name="listaTicket">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="Ticket" minOccurs="0" maxOccurs="unbounded"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  

  <xsd:element name="Ticket">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="text"  minOccurs="1" maxOccurs="1"/>
      </xsd:sequence>
        <xsd:attribute name="id_ticket" type="xsd:interger" use="required"/>
        <xsd:attribute name="id_utente" type="xsd:interger" use="required"/>
        <xsd:attribute name="data" type="xsd:string" use="required"/>
        <xsd:attribute name="ora" type="xsd:time" use="required"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="text" type="xsd:string" />
  </xsd:element>
  
</xsd:schema>