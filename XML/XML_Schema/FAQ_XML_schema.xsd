<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" >
  <xsd:element name="listaFAQ">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="FAQ" minOccurs="0" maxOccurs="unbounded"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
    <xsd:element name="FAQ">
     <xsd:complexType>
       <xsd:sequence>
         <xsd:element nome="Domanda" type="xsd:string " minOccurs="1" maxOccurs="1"/>
